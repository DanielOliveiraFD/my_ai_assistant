# Segredos
.env

# Memória de longo prazo (dados pessoais do usuário, nunca versionar)
jarvis/memory.sqlite3

# Python
__pycache__/
*.pyc
.venv/
venv/

# Modelos e áudio baixados (grandes, não versionar)
jarvis/models/*.onnx
jarvis/models/*.tflite
jarvis/models/*.json
!jarvis/models/.gitkeep

# Logs do LaunchAgent
jarvis/logs/*.log
!jarvis/logs/.gitkeep

# App gerado (caminhos específicos da máquina) — só o template é versionado
macos/Jarvis.app

# macOS
.DS_Store
